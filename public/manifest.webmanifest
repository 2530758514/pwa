{
  "id": "/",
  "name": "SlotFront H5",
  "short_name": "SlotFront H5",
  "description": "Welcome to our entertainment platform, designed to bring you a smooth, exciting, and enjoyable experience anytime, anywhere.",
  "start_url": "/?pwa_launch=1",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "theme_color": "#000000",
  "background_color": "#000000",
  "prefer_related_applications": false,
  "related_applications": [
    {
      "platform": "webapp",
      "url": "/manifest.webmanifest"
    },
    {
      "platform": "webapp",
      "url": "/pwa-dynamic-manifest.webmanifest"
    }
  ],
  "protocol_handlers": [
    {
      "protocol": "web+hslot",
      "url": "/#protocol_url=%s"
    }
  ],
  "icons": [
    {
      "src": "/pwa-icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/pwa-icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "screenshots": [
    {
      "src": "/pwa-source/1.png",
      "sizes": "488x1055",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "App preview 1"
    },
    {
      "src": "/pwa-source/2.png",
      "sizes": "488x1055",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "App preview 2"
    },
    {
      "src": "/pwa-source/3.png",
      "sizes": "488x1055",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "App preview 3"
    },
    {
      "src": "/pwa-source/4.png",
      "sizes": "488x1055",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "App preview 4"
    }
  ],
  "lang": "en",
  "dir": "ltr"
}
