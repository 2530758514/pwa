# App name used for document titles and manifest fallbacks.
VITE_APP_NAME=SlotFront H5

# Frontend request base path. Browser requests use /api/pwa_h5_detail by default.
VITE_API_BASE_URL=/api

# Development proxy settings.
VITE_PROXY_PREFIX=/api
VITE_PROXY_TARGET=https://kingapi.scoutai.games/
# VITE_PROXY_TARGET=https://slot4.bt001.pro/
# VITE_PROXY_TARGET=https://h5api.draft7bk.uk/
VITE_PROXY_REWRITE_PREFIX=
VITE_PROXY_STRIP_PREFIX=true

# Fallback H5 iframe target when /pwa_h5_detail does not return h5_url.
VITE_H5_APP_URL=

# PWA manifest behavior.
VITE_PWA_MANIFEST_SOURCE=dynamic
# Use anonymous for a public cross-origin config_url manifest.
# Change to use-credentials only if the manifest host requires cookies.
VITE_PWA_MANIFEST_CROSSORIGIN=anonymous
VITE_PWA_APP_START_URL=/
VITE_PWA_APP_SCOPE=/
VITE_PWA_APP_ID=/

# Service worker is required for the Android install prompt path.
# Set false only when you intentionally need to clear dev registrations.
VITE_ENABLE_PWA_SW=true

# Enable mobile debug console. Dev mode enables it automatically.
VITE_ENABLE_VCONSOLE=true
VITE_ENABLE_API_ERROR_TOAST=true

# Player identity center. The runtime derives client_id from the exact location.origin.
# Global identity-center switch. false bypasses callbacks, redirects, and iframe handoff.
VITE_PLAYER_IDENTITY_ENABLED=true
VITE_PLAYER_IDENTITY_CENTER_ORIGIN=https://zhongzhuan.draft7bk.uk
VITE_PLAYER_IDENTITY_CALLBACK_PATH=/
VITE_PLAYER_SESSION_ENABLED=false
# Exact comma-separated H5 iframe Origins accepted by the PWA parent bridge.
VITE_PLAYER_SESSION_IFRAME_ORIGINS=
# Old installed PWA must resolve the play08 top-level migration before bootstrap/register.
VITE_PLAYER_SESSION_INSTALLED_PWA_MIGRATION_REQUIRED=true
# Keep false until migration issue/redeem is deployed and integrated.
VITE_PLAYER_SESSION_GUEST_REGISTRATION_ENABLED=false
